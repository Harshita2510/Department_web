{
  "name": "sgsits-website-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed:admin": "node scripts/seed-admin.js",
    "audit:notices": "node scripts/audit-notice-assets.js",
    "audit:faculty-images": "node scripts/audit-faculty-images.js",
    "load-test:public": "node scripts/load-test-public.js",
    "check": "find src scripts -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test",
    "backup": "node scripts/backup/run.js",
    "backup:now": "node scripts/backup/run.js --force",
    "backup:check": "node scripts/backup/check.js",
    "backup:auth": "node scripts/backup/authorize.js",
    "backup:decrypt": "node scripts/backup/decrypt.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "morgan": "^1.10.1",
    "multer": "^2.3.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.3.0",
    "zod": "^4.1.5"
  }
}
