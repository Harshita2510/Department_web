# Copy to backend/backup.env on the server and restrict it: chmod 600 backup.env
# MONGODB_URI and MONGODB_DB_NAME are read from the website's .env; anything set here overrides it.

# Optional: a read-only Atlas user for backups (Atlas specific privilege: read@sgsits_website).
# BACKUP_MONGODB_URI=<connection string of the read-only Atlas user>

# OAuth "Desktop app" client created in the college backup account's Google Cloud project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Printed by: npm run backup:auth
GOOGLE_REFRESH_TOKEN=

# At least 20 characters. Write it down and give it to the college; without it backups cannot be restored.
BACKUP_ENCRYPTION_PASSPHRASE=

# Failure and low-space alerts are emailed here (sent from the backup Google account).
BACKUP_ALERT_EMAIL=backup-alerts@example.com

# Optional settings (defaults shown)
# BACKUP_DRIVE_FOLDER=Website Backups
# BACKUP_STATE_DIR=/path/to/backend/.backup
# MONGODUMP_PATH=mongodump
# BACKUP_LOW_SPACE_BYTES=1073741824

# Proxy: if the college network forces traffic through a proxy, set NODE_USE_ENV_PROXY=1 and HTTPS_PROXY
# in the crontab line, not here (Node reads them at startup, before this file is loaded). See docs/BACKUP.md.
